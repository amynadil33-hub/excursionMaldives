# --- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by the BML payment webhook to confirm paid orders.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used for auth & payment redirects
NEXT_PUBLIC_SITE_URL=https://excursionmaldives.com
# Optional: local development redirect for Supabase email confirmations
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# --- Bank of Maldives (BML Connect) payment gateway -------------------------
# Leave empty until BML issues merchant credentials. Checkout will stop at
# "payment pending" and never mark orders paid without a confirmed transaction.
BML_API_KEY=
BML_APP_ID=
# https://api.merchants.bankofmaldives.com.mv (production)
# https://api.uat.merchants.bankofmaldives.com.mv (UAT / sandbox)
BML_API_BASE_URL=https://api.uat.merchants.bankofmaldives.com.mv
BML_WEBHOOK_SECRET=
